{
  "name": "takewright",
  "version": "0.1.0",
  "description": "Script, capture, and render repeatable product demos.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "keywords": [
    "terminal",
    "demo",
    "video",
    "vhs",
    "remotion",
    "ffmpeg",
    "automation"
  ],
  "scripts": {
    "demo:new": "tsx scripts/new-demo.ts",
    "demo:render": "tsx scripts/render-demo.ts",
    "demo:inspect": "tsx scripts/inspect-demo.ts",
    "demo:validate": "tsx scripts/validate-demo.ts",
    "demo:doctor": "tsx scripts/doctor.ts",
    "demo:smoke": "tsx scripts/render-demo.ts example-demo --format landscape --smoke",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "execa": "^10.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.529",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
